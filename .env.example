# Copy to `.env` and fill in. `.env` is gitignored.
# Heldenbuch reads these via python-dotenv-free parsing (see config.py) or from
# the real environment -- whichever is set.

# OpenAI key. This one alone runs everything: writing the stories, drawing
# the pictures (gpt-image-2), narration, and the consistency check.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio key, for the `gemini` backend (Nano Banana image models)
# and the gemini judge. A second image provider unblocks the independent
# drift checker and the backend scout, and adds 2K/4K renders.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Black Forest Labs key, for the `bfl` backend (FLUX.2 / FLUX.1 Kontext).
# Far cheaper than OpenAI at print resolution (flat price per image).
# https://dashboard.bfl.ai/
BFL_API_KEY=

# Anthropic key. A second text/vision provider: with it, Claude can check
# pages that OpenAI drew, instead of OpenAI grading its own homework.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Local ComfyUI (the `comfy` backend -- free, images never leave the machine).
# No key: it needs a running ComfyUI server and an exported workflow file.
# Both are optional; defaults are localhost:8188 and <project>/comfy_workflow.json.
# Setup instructions: src/heldenbuch/backends/comfy.py
#COMFY_URL=http://127.0.0.1:8188
#COMFY_WORKFLOW=comfy_workflow.json
